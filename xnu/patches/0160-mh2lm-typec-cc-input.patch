--- a/iokit/Kernel/arm/SweetPmicPower.cpp
+++ b/iokit/Kernel/arm/SweetPmicPower.cpp
@@ -88,7 +88,7 @@ sweet_pmic_power_read_snapshot(SweetBattSnapshot &next, bool refreshInput,
 		/* Invalidate before acquiring a replacement. Saturation fails closed;
 		 * no wrap can make an earlier source epoch appear current. */
 		next.valid &= ~sb_input_mask();
-		next.apsdCoherent = false;
+		next.apsdCoherent = next.ccCoherent = false;
 		next.inputStartedNs = next.inputCompletedNs = 0;
 		if (next.inputEpoch != ~0ULL) {
 			++next.inputEpoch;
@@ -96,9 +96,8 @@ sweet_pmic_power_read_snapshot(SweetBattSnapshot &next, bool refreshInput,
 		}
 	}
 	for (unsigned i = 0; i < SB_REG_COUNT; ++i) {
-		if (!refreshInput && (sb_input_mask() & (1ULL << i))) { continue; }
-		/* Source result is acquired below, bracketed by status/VBUS reads. */
-		if (i == SB_APSD || i == SB_RESULT || i == SB_USB) { continue; }
+		/* Input tuple is acquired below, bracketed by status/VBUS reads. */
+		if (sb_input_mask() & (1ULL << i)) { continue; }
 		uint8_t value = 0;
 		int rc = sweet_spmi_charger_read(2, addresses[i], &value);
 		next.errors[i] = rc;
@@ -110,28 +109,31 @@ sweet_pmic_power_read_snapshot(SweetBattSnapshot &next, bool refreshInput,
 		/* No sleeping, rerun, or retry. Reject a result changing during reads.
 		 * Matching bytes are a bounded consistency check, not a PMIC snapshot
 		 * or proof of a new BC1.2 session. Source-event provenance is separate. */
-		const unsigned fields[] = {SB_USB, SB_APSD, SB_RESULT};
-		const unsigned regs[] = {0x1310, 0x1307, 0x1308};
-		for (unsigned i = 0; i < 3; ++i) {
+		const unsigned fields[] = {SB_USB, SB_TYPEC, SB_ATTACHED, SB_MISC,
+		    SB_DEBUG_ACCESS, SB_LEGACY, SB_APSD_OPTIONS, SB_APSD, SB_RESULT};
+		for (unsigned i = 0; i < sizeof(fields) / sizeof(fields[0]); ++i) {
 			unsigned field = fields[i];
 			uint8_t value = 0;
-			int rc = sweet_spmi_charger_read(2, regs[i], &value);
+			int rc = sweet_spmi_charger_read(2, addresses[field], &value);
 			next.errors[field] = rc;
 			next.raw[field] = rc ? 0 : value;
 			if (!rc) { next.valid |= 1ULL << field; }
 		}
-		const unsigned afterFields[] = {SB_APSD, SB_USB};
-		const unsigned afterRegs[] = {0x1307, 0x1310};
-		for (unsigned i = 0; i < 2; ++i) {
+		const unsigned afterFields[] = {SB_APSD, SB_TYPEC, SB_ATTACHED, SB_MISC,
+		    SB_DEBUG_ACCESS, SB_LEGACY, SB_APSD_OPTIONS, SB_USB};
+		for (unsigned i = 0; i < sizeof(afterFields) / sizeof(afterFields[0]); ++i) {
 			unsigned field = afterFields[i];
 			uint8_t after = 0;
-			int rc = sweet_spmi_charger_read(2, afterRegs[i], &after);
+			int rc = sweet_spmi_charger_read(2, addresses[field], &after);
 			if (rc || !sb_valid(next, field) || after != next.raw[field]) {
 				next.valid &= ~(1ULL << field);
 				if (!next.errors[field]) { next.errors[field] = rc ? rc : SWEET_SPMI_VERIFY; }
 			}
 		}
 		next.apsdCoherent = sb_valid(next, SB_USB) && sb_valid(next, SB_APSD) && sb_valid(next, SB_RESULT);
+		/* CC validity does not require APSD enable, DONE, or RESULT. Compare
+		 * every CC status byte and VBUS before/after; no retry or MMIO. */
+		next.ccCoherent = (next.valid & sb_cc_mask()) == sb_cc_mask();
 		if (next.inputStartedNs) { next.inputCompletedNs = powerNow(); }
 	}
 	uint8_t present = 0;
diff --git a/iokit/Kernel/arm/SweetSpmiInterruptMux.cpp b/iokit/Kernel/arm/SweetSpmiInterruptMux.cpp
index 1c6371df6fb8fe915a21dc1719da17009c9f5744..95f7185184d7625a6e4f97798d85cef1f43d8481 100644
--- a/iokit/Kernel/arm/SweetSpmiInterruptMux.cpp
+++ b/iokit/Kernel/arm/SweetSpmiInterruptMux.cpp
@@ -51,6 +51,14 @@ static const MuxRoute routeTemplates[] = {
 	/* PM8150B DTS: source-change USBIN bit6 and CHGR error bit0 rising. */
 	{2, 0x13, 6, SWEET_BATT_IRQ_SOURCE, MUX_BATTERY, 1, "battery-source"},
 	{2, 0x10, 0, SWEET_BATT_IRQ_FAULT, MUX_BATTERY, 1, "battery-fault"},
+	/* PM8150B Type-C DTS: each status event queues one typed input refresh.
+	 * No CC/SPMI work runs in the GIC callback or consumer notification. */
+	{2, 0x15, 0, SWEET_BATT_IRQ_TYPEC, MUX_BATTERY, 1, "battery-typec-rid"},
+	{2, 0x15, 2, SWEET_BATT_IRQ_TYPEC, MUX_BATTERY, 1, "battery-typec-cc"},
+	{2, 0x15, 3, SWEET_BATT_IRQ_TYPEC, MUX_BATTERY, 3, "battery-typec-vconn"},
+	{2, 0x15, 4, SWEET_BATT_IRQ_TYPEC, MUX_BATTERY, 1, "battery-typec-vbus"},
+	{2, 0x15, 5, SWEET_BATT_IRQ_TYPEC, MUX_BATTERY, 1, "battery-typec-attach"},
+	{2, 0x15, 6, SWEET_BATT_IRQ_TYPEC, MUX_BATTERY, 3, "battery-typec-legacy"},
 	{2, 0x31, 0, SWEET_ADC5_IRQ_EOC, MUX_ADC5, 1, "adc5-eoc"},
 };
 static_assert(sizeof(routeTemplates) / sizeof(routeTemplates[0]) == SWEET_MUX_ROUTE_COUNT,
