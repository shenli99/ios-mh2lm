diff --git a/iokit/Kernel/arm/SweetSpmiInterruptMux.cpp b/iokit/Kernel/arm/SweetSpmiInterruptMux.cpp
--- a/iokit/Kernel/arm/SweetSpmiInterruptMux.cpp
