diff --git a/iokit/Kernel/arm/SweetMDSSScanout.inc b/iokit/Kernel/arm/SweetMDSSScanout.inc
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetMDSSScanout.inc
@@ -0,0 +1,57 @@
+/* F4 prerequisite. Register meanings checked against LG's DRM/SDE drivers,
+ * not its unused fbdev stack. SSPP +0x70 is SECURITY, never an active address.
+ * Every access is a read under SweetMDSS's existing workloop gate. */
+IOReturn
+SweetMDSS::inspectScanout(SweetScanoutSnapshot *snapshot)
+{
+ if (!snapshot) return kIOReturnBadArgument;
+ bzero(snapshot,sizeof(*snapshot));
+ return fGate ? fGate->runAction(scanoutInspectAction,snapshot) : kIOReturnNotReady;
+}
+IOReturn
+SweetMDSS::scanoutInspectAction(OSObject *owner,void *arg,void *,void *,void *)
+{
+ SweetMDSS *s=(SweetMDSS *)owner;
+ SweetScanoutSnapshot *v=(SweetScanoutSnapshot *)arg;
+ if (!v) return kIOReturnBadArgument;
+ if (!s->fAccepting || s->isInactive() || !s->dp_clocks_on() ||
+     !s->dp_smmu || !s->dp_smmu_cb2 || !s->fMaps[9] || !s->fMaps[10]) return kIOReturnNotReady;
+ /* Sequential observations, NOT an atomic hardware snapshot. The top half
+  * may update its timestamp independently; use the last processed frame. */
+ v->frame=s->fFrameCount; v->ticks=s->fFrameTicks;
+ vm_offset_t p=s->dp_sspp,c=s->dp_ctl,i=s->dp_intf1;
+ v->size=dp_rd(p,0); v->xy=dp_rd(p,8); v->out=dp_rd(p,0xc); v->outXY=dp_rd(p,0x10);
+ v->address=dp_rd(p,0x14); v->stride=dp_rd(p,0x24); v->format=dp_rd(p,0x30);
+ v->unpack=dp_rd(p,0x34); v->op=dp_rd(p,0x38); v->secure=dp_rd(p,0x70);
+ v->flush=dp_rd(c,0x18); v->start=dp_rd(c,0x1c); v->ctlTop=dp_rd(c,0x14);
+ v->intfCfg=dp_rd(i,4); v->intfStatus=dp_rd(i,0x26c); v->te=dp_rd(i,0x284);
+ v->autoRefresh=dp_rd(i,0x2b4); v->wrCount=dp_rd(i,0x290);
+ v->line=dp_rd(i,0x2b0); v->outLine=dp_rd(i,0x2ac);
+ v->mdpEnable=dp_rd(s->fMaps[9]->getVirtualAddress(),0x1010);
+ v->mdpStatus=dp_rd(s->fMaps[9]->getVirtualAddress(),0x1014);
+ v->tearEnable=dp_rd(s->fMaps[10]->getVirtualAddress(),0);
+ v->tearStatus=dp_rd(s->fMaps[10]->getVirtualAddress(),4);
+ p=s->dp_smmu;
+ v->smmuID0=dp_rd(p,0x20); v->smmuID1=dp_rd(p,0x24);
+ v->knownSmmu=v->smmuID0==0x4c017e5eu && v->smmuID1==0x60000038u;
+ if (!v->knownSmmu) return kIOReturnSuccess; /* no guessed layout reads */
+ v->smmuCR0=dp_rd(p,0); v->smmuFault=dp_rd(p,0x48);
+ const unsigned count=v->smmuID0&0xffu;
+ for (unsigned n=0;n<count;++n) {
+  uint32_t smr=dp_rd(p,0x800u+4u*n),mask=(smr>>16)&0x7fffu;
+  if (!(smr&0x80000000u) || ((smr&0x7fffu&~mask)!=(SMMU_SID&~mask))) continue;
+  ++v->matches;
+  if (v->matches==1) { v->streamIndex=n; v->smr=smr; v->s2cr=dp_rd(p,0xc00u+4u*n); }
+ }
+ /* Only CB2 is mapped/validated in the ADT. A changed or ambiguous route
+  * is reported as such, never redirected or followed through a raw mapping. */
+ if (v->matches!=1 || ((v->s2cr>>16)&3u)!=0 || (v->s2cr&0xffu)!=2) return kIOReturnSuccess;
+ v->cb2Observed=true;
+ v->cbar=dp_rd(s->dp_smmu_gr1,8); v->cba2r=dp_rd(s->dp_smmu_gr1,0x808);
+ p=s->dp_smmu_cb2;
+ v->sctlr=dp_rd(p,0); v->ttbcr=dp_rd(p,0x30);
+ v->ttbrLo=dp_rd(p,0x20); v->ttbrHi=dp_rd(p,0x24);
+ v->mairLo=dp_rd(p,0x38); v->mairHi=dp_rd(p,0x3c);
+ v->cbFault=dp_rd(p,0x58); v->farLo=dp_rd(p,0x60); v->farHi=dp_rd(p,0x64);
+ return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/SweetScanoutPool.h b/iokit/Kernel/arm/SweetScanoutPool.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetScanoutPool.h
@@ -0,0 +1,21 @@
+/* F4 owned scanout storage. This object does not program hardware. */
+#ifndef SWEET_SCANOUT_POOL_H
+#define SWEET_SCANOUT_POOL_H
+#if defined(ARM64_BOARD_CONFIG_MH2LM)
+#include <IOKit/IOBufferMemoryDescriptor.h>
+class SweetScanoutPool : public OSObject {
+ OSDeclareDefaultStructors(SweetScanoutPool);
+ IOBufferMemoryDescriptor *fBuffers[2];
+ bool fPrepared[2];
+ uint64_t fPhysical[2];
+ uint32_t fWidth, fHeight, fStride;
+ size_t fBytes;
+public:
+ static SweetScanoutPool *withGeometry(uint32_t,uint32_t,uint32_t);
+ bool seedABL(const void *,size_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t);
+ uint64_t physical(unsigned n) const { return n<2 ? fPhysical[n] : 0; }
+ size_t bytes(void) const { return fBytes; }
+ void free(void) APPLE_KEXT_OVERRIDE;
+};
+#endif
+#endif
diff --git a/iokit/Kernel/arm/SweetScanoutPool.inc b/iokit/Kernel/arm/SweetScanoutPool.inc
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetScanoutPool.inc
@@ -0,0 +1,75 @@
+/* Early thread-context allocation, before the GUI is published. No heap
+ * allocation or >10MiB copy in a vsync/notification callback or spin lock. */
+OSDefineMetaClassAndStructors(SweetScanoutPool,OSObject);
+SweetScanoutPool *
+SweetScanoutPool::withGeometry(uint32_t width,uint32_t height,uint32_t stride)
+{
+ if (!width || !height || width>4096 || height>4096 || (stride&63u) ||
+     stride<(uint64_t)width*4u || stride>65536u) return NULL;
+ const uint64_t bytes=(uint64_t)stride*height;
+ if (!bytes || bytes>64u*1024u*1024u) return NULL;
+ SweetScanoutPool *s=OSTypeAlloc(SweetScanoutPool);
+ if (!s) return NULL;
+ if (!s->init()) { s->release(); return NULL; }
+ s->fWidth=width; s->fHeight=height; s->fStride=stride; s->fBytes=(size_t)bytes;
+ for (unsigned n=0;n<2;++n) {
+  s->fBuffers[n]=IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+      kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMemoryMapperNone |
+      kIOMapWriteCombineCache,bytes,0xffffffffULL);
+  if (!s->fBuffers[n] || s->fBuffers[n]->getLength()<bytes ||
+      !s->fBuffers[n]->getBytesNoCopy()) {
+   SWEET_LOG_ERROR("SWEET FB SCANOUT: buffer index=%u allocation/mapping failed bytes=%llu\n",n,bytes);
+   s->release(); return NULL;
+  }
+  IOReturn rc=s->fBuffers[n]->prepare(kIODirectionInOut);
+  if (rc!=kIOReturnSuccess) {
+   SWEET_LOG_ERROR("SWEET FB SCANOUT: buffer index=%u prepare failed rc=%#x\n",n,(unsigned)rc);
+   s->release(); return NULL;
+  }
+  s->fPrepared[n]=true;
+  IOByteCount contiguous=0;
+  uint64_t pa=s->fBuffers[n]->getPhysicalSegment(0,&contiguous,kIOMemoryMapperNone);
+  if (!pa || (pa&4095u) || pa>=0x100000000ULL || bytes>0x100000000ULL-pa || contiguous<bytes) {
+   SWEET_LOG_ERROR("SWEET FB SCANOUT: buffer index=%u physical check failed pa=%#llx segment=%llu bytes=%llu\n",
+       n,pa,(uint64_t)contiguous,bytes);
+   s->release(); return NULL;
+  }
+  s->fPhysical[n]=pa;
+ }
+ if (s->fPhysical[0]<s->fPhysical[1]+bytes && s->fPhysical[1]<s->fPhysical[0]+bytes) {
+  SWEET_LOG_ERROR("SWEET FB SCANOUT: buffer physical ranges overlap\n");
+  s->release(); return NULL;
+ }
+ return s;
+}
+bool
+SweetScanoutPool::seedABL(const void *source,size_t length,uint32_t width,uint32_t height,
+    uint32_t stride,uint32_t x,uint32_t y)
+{
+ /* Source is the physical panel rectangle, NOT the larger logical canvas.
+  * Validate every bound before touching memory; only destination A is written.
+  * The caller also proves the physical source and both buffers do not alias. */
+ if (!source || !width || !height || x>fWidth || y>fHeight ||
+     width>fWidth-x || height>fHeight-y || stride<(uint64_t)width*4u ||
+     (uint64_t)(height-1)*stride+(uint64_t)width*4u>length) return false;
+ /* Do not initialize storage in withGeometry(): the caller must first
+  * reject overlap with the whole display reservation, before ANY pixel write. */
+ bzero(fBuffers[0]->getBytesNoCopy(),fBytes);
+ bzero(fBuffers[1]->getBytesNoCopy(),fBytes);
+ uint8_t *dst=(uint8_t *)fBuffers[0]->getBytesNoCopy();
+ const uint8_t *src=(const uint8_t *)source;
+ for (uint32_t row=0;row<height;++row)
+  memcpy(dst+(size_t)(y+row)*fStride+(size_t)x*4u,src+(size_t)row*stride,(size_t)width*4u);
+ return true;
+}
+void
+SweetScanoutPool::free(void)
+{
+ /* This first stage never submits a buffer to MDP. Later ownership transfer
+  * must keep the pool retained until hardware is proven to have stopped. */
+ for (unsigned n=0;n<2;++n) {
+  if (fPrepared[n]) { (void)fBuffers[n]->complete(kIODirectionInOut); fPrepared[n]=false; }
+  OSSafeReleaseNULL(fBuffers[n]);
+ }
+ OSObject::free();
+}
