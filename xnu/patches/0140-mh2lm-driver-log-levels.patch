+/* Boot argument 0=ERROR, 1=WARN, 2=INFO (default), 3=DEBUG. This only
+ * filters Sweet driver call sites; XNU and userspace keep their own logs. */
+int
+sweet_log_level_enabled(unsigned level)
+{
+	static volatile unsigned threshold = ~0u;
+	unsigned current = __atomic_load_n(&threshold, __ATOMIC_ACQUIRE);
+	if (current == ~0u) {
+		int requested = 2;
+		(void)PE_parse_boot_argn("sweetloglevel", &requested, sizeof(requested));
+		if (requested < 0 || requested > 3) {
+			requested = 2;
+		}
+		unsigned expected = ~0u;
+		(void)__atomic_compare_exchange_n(&threshold, &expected,
+		    (unsigned)requested, false, __ATOMIC_RELEASE, __ATOMIC_ACQUIRE);
+		current = __atomic_load_n(&threshold, __ATOMIC_ACQUIRE);
+	}
+	return level <= current;
+}
