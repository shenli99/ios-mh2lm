+int sweet_spmi_adc5_advance(struct sweet_adc5_session *, enum sweet_adc5_cause,
+ struct sweet_adc5_measurement *);
+int sweet_spmi_adc5_abort(struct sweet_adc5_session *);
 #ifdef __cplusplus
 }
 #endif
