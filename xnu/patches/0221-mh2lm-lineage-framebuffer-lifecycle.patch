diff --git a/iokit/Kernel/arm/SweetDisplayBackend.h b/iokit/Kernel/arm/SweetDisplayBackend.h
--- a/iokit/Kernel/arm/SweetDisplayBackend.h
+++ b/iokit/Kernel/arm/SweetDisplayBackend.h
@@ -9,8 +9,9 @@
 #include "SweetDSICommand.h"
 
 /* Warm transactions preserve rails and panel initialization. Full prepare,
- * reset and unprepare remain separate operations. Mode2 extends OFF/ON with
- * profile sleep/reset recovery while retaining every supply vote. Mode3
+ * reset and unprepare remain separate operations. Mode2 follows Lineage
+ * suspend ULPS: profile sleep/reset, DATA/link parking and panel-only supply
+ * vote withdrawal/restore, while shared core/config power stays held. Mode3
  * additionally releases/reacquires managed DATA leases, retaining a separate
  * config floor and all boot/core/link/power ownership. Mode4 shuts down and
  * reconstructs host/PHY/PLL, retaining all resource tickets. */
diff --git a/iokit/Kernel/arm/SweetFBService.inc b/iokit/Kernel/arm/SweetFBService.inc
--- a/iokit/Kernel/arm/SweetFBService.inc
+++ b/iokit/Kernel/arm/SweetFBService.inc
@@ -10,8 +10,13 @@
  fStateGateAdded=true;
  int lifecycle=0; (void)PE_parse_boot_argn("sweetpanellifecycle",&lifecycle,sizeof(lifecycle));
  fPanelLifecycleRequested=lifecycle>=1 && lifecycle<=6;fPanelLifecycleFull=lifecycle>=2 && lifecycle<=6;
- fPanelLifecycleDataParking=lifecycle==3 || lifecycle==5 || lifecycle==6;fPanelLifecycleLinkCycle=lifecycle==4 || lifecycle==5 || lifecycle==6;
- fPanelLifecycleSupplyCycle=lifecycle==6;
+ /* Mode2 follows the MDSS Lineage suspend path: parked DATA/link and this
+  * panel's withdrawn supply votes are the successful OFF state. Use the
+  * same full supply/restore proofs as mode6, not the old all-held contract. */
+ fPanelLifecycleDataParking=lifecycle==2 || lifecycle==3 || lifecycle==5 || lifecycle==6;
+ fPanelLifecycleLinkCycle=lifecycle==2 || lifecycle==4 || lifecycle==5 || lifecycle==6;
+ fPanelLifecycleSupplyCycle=lifecycle==2 || lifecycle==6;
+ if (lifecycle==2) SWEET_LOG_INFO("SWEET FB PANEL: Lineage mode2 supply/link/data completion enabled\n");
  if (fPanelLifecycleRequested && (!fHardwareVsyncRequested || !fOwnScanoutRequested)) return false;
  if (fHardwareVsyncRequested && !setupHardwareVsync()) return false;
  fDisplayClient=SweetDisplayClient::withOwner(this,fWorkLoop,backendChanged);
