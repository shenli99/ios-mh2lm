+bool
+IOQcomRSCChannel::readRegister(unsigned window,uint32_t offset,uint32_t *value)
+{
+	/* The identity budget is the card's promise: ten loads, whatever the DB
+	 * holds. The query is charged to fQueryReads instead. */
