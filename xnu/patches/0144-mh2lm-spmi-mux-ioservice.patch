+
+extern "C" bool
+sweet_spmi_mux_irq(unsigned int intid)
+{
+	if (intid != MUX_INTID) {
+		return false;
+	}
+	IOSimpleLock *lock = __atomic_load_n(&irqLock, __ATOMIC_ACQUIRE);
+	if (lock) {
+		IOInterruptState saved = IOSimpleLockLockDisableInterrupt(lock);
