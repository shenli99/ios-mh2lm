+
+extern "C" int
+sweet_spmi_mux_start(void)
+{
+	/* Late board publication, NOT a direct call to hardware initialization.
+	 * Synchronous matching ensures the following BSD key init sees a final
+	 * READY/FAILED result. Battery may subscribe before or after matching. */
+	static volatile unsigned requested;
+	unsigned expected = 0;
+	if (!__atomic_compare_exchange_n(&requested, &expected, 1u, false,
+	    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		return __atomic_load_n(&published, __ATOMIC_ACQUIRE) == 1 ? 0 : -1;
+	}
+	IOPlatformExpert *platform = IOService::getPlatform();
+	if (!platform) {
+		return startFailed();
+	}
+	SweetSpmiMuxDevice *nub = new SweetSpmiMuxDevice;
+	if (!nub) {
+		return startFailed();
+	}
+	if (!nub->init() || !nub->attach(platform)) {
+		nub->release();
+		return startFailed();
+	}
+	nub->setName("mh2lm-spmi-mux");
+	nub->registerService(kIOServiceSynchronous);
+	bool ready = __atomic_load_n(&published, __ATOMIC_ACQUIRE) == 1;
+	if (!ready) {
+		SWEET_LOG_ERROR("SWEET MUX: IOService matching/start failed; no polling fallback\n");
+		publishReadiness(-1);
+		(void)nub->terminate(kIOServiceSynchronous);
+	}
+	nub->release(); /* service plane owns the successfully published nub */
+	return ready ? 0 : -1;
 }
 
