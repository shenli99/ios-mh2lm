+	uint32_t value=0;
+	if (!readRegister(window,offset,&value)) {
+		SWEET_LOG_ERROR("SWEET CLOCK: planID=C2 resource=%s consumer=sweetclock-share phase=share-request result=%d detail=read-failed hold=1\n",
+		 resource,kIOReturnNotReady);
