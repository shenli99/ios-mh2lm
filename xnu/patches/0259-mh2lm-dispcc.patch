+    subprocess.run([sys.executable, str(Path(m.__file__)), '--dispcc', '--clock-diag',
+                    str(source), str(both)], check=True)
+    assert both.read_bytes() == m.derive(blob, dispcc=True, clock_diag=True)
+    tree, end = adt.parse(both.read_bytes())
