+/* F3: SM8150 INTF1 TE RD_PTR, hardware-owner workloop only.
+ * LG sde_hw_interrupts.c: TE IRQ +0x6e800, EN/STATUS/W1C=0/4/8, bit2.
+ * No Linux IRQ domain. Physical dispatch follows the established sleh callback.
