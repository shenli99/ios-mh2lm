+			    id, name->getCStringNoCopy(), value ? value->getMetaClass()->getClassName() : "null",
+			    string ? string->getCStringNoCopy() : "-");
+		}
+	}
+	if (props->getCount() > count) {
+		SWEET_LOG_INFO("SWEET SURF TRACE: id=%u remaining=%u omitted\n", id, props->getCount()-count);
