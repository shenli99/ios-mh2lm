mh2lm: separate PON channel mapping from register reads (0131)

The PON route micro-diagnostics must distinguish an invalid or unavailable
channel mapping from a fault on the first register access through that
mapping. Keep the channel-window map operation as its own read-only part,
then test ACC_ENABLE and IRQ_STATUS independently. The address remains the
Linux v5 APID-derived window; this patch only improves failure isolation.

--- a/bsd/dev/sweet_spmi.h
+++ b/bsd/dev/sweet_spmi.h
@@ -19,9 +19,11 @@
 #define SWEET_SPMI_IRQ_DIAG_ROUTE_OWNER   0x02u
 #define SWEET_SPMI_IRQ_DIAG_ROUTE_ENABLE  0x04u
 #define SWEET_SPMI_IRQ_DIAG_ROUTE_STATUS  0x08u
+#define SWEET_SPMI_IRQ_DIAG_ROUTE_CHANNEL 0x10u
 #define SWEET_SPMI_IRQ_DIAG_ROUTE_ALL \
 	(SWEET_SPMI_IRQ_DIAG_ROUTE_META | SWEET_SPMI_IRQ_DIAG_ROUTE_OWNER | \
-	SWEET_SPMI_IRQ_DIAG_ROUTE_ENABLE | SWEET_SPMI_IRQ_DIAG_ROUTE_STATUS)
+	SWEET_SPMI_IRQ_DIAG_ROUTE_ENABLE | SWEET_SPMI_IRQ_DIAG_ROUTE_STATUS | \
+	SWEET_SPMI_IRQ_DIAG_ROUTE_CHANNEL)
 /* Read-only route inspection for one PMIC peripheral. It never registers a
  * GIC handler, enables/clears a PMIC interrupt or writes a PMIC register. */
 void sweet_spmi_irq_diag_source(unsigned sid, unsigned peripheral, const char *name);
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -94,7 +94,8 @@
 		if ((parts & SWEET_SPMI_IRQ_DIAG_ROUTE_OWNER) != 0) {
 			ownerMask = sp_rd(intr, 4u * ownerWord);
 		}
-		if ((parts & (SWEET_SPMI_IRQ_DIAG_ROUTE_ENABLE |
+		if ((parts & (SWEET_SPMI_IRQ_DIAG_ROUTE_CHANNEL |
+		    SWEET_SPMI_IRQ_DIAG_ROUTE_ENABLE |
 		    SWEET_SPMI_IRQ_DIAG_ROUTE_STATUS)) != 0) {
 			vm_offset_t chnls = ml_io_map(
 			    SP_CHNLS_PA + SP_CHNLS_APID_STRIDE * apid, 0x1000);
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -300,8 +300,8 @@
 	if (irqDiag != 0) {
 		unsigned mask = (unsigned)irqDiag;
 		printf("SWEET KEYS IRQ: read-only diagnostic mask=%#x\n", mask);
-		/* bit 0: helper init; bits 1/2 or 5..8: PMIC-arb route probes. */
-		if ((mask & 0x1e7u) != 0) {
+		/* bit 0: helper init; bits 1/2 or 5..9: PMIC-arb route probes. */
+		if ((mask & 0x3e7u) != 0) {
 			if (sweet_spmi_init() != 0) {
 				printf("SWEET KEYS IRQ: shared SPMI preflight unavailable\n");
 			} else {
@@ -319,10 +319,14 @@
 				}
 				if ((mask & 0x80u) != 0) {
 					sweet_spmi_irq_diag_source_parts(0u, KEYS_PON_RT >> 8,
-					    "keys-pon", SWEET_SPMI_IRQ_DIAG_ROUTE_ENABLE);
+					    "keys-pon", SWEET_SPMI_IRQ_DIAG_ROUTE_CHANNEL);
 				}
 				if ((mask & 0x100u) != 0) {
 					sweet_spmi_irq_diag_source_parts(0u, KEYS_PON_RT >> 8,
+					    "keys-pon", SWEET_SPMI_IRQ_DIAG_ROUTE_ENABLE);
+				}
+				if ((mask & 0x200u) != 0) {
+					sweet_spmi_irq_diag_source_parts(0u, KEYS_PON_RT >> 8,
 					    "keys-pon", SWEET_SPMI_IRQ_DIAG_ROUTE_STATUS);
 				}
 #if SWEET_DEV_KEYS_VOLUME
