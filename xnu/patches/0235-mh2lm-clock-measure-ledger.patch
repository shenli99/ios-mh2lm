+{
+	if (shortCount==fullCount) return 0;   /* counter did not advance: not running */
+	uint64_t scaled=((uint64_t)fullCount*10u+15u)*kGccXoDiv4Hz;
+	return scaled/((uint64_t)kGccMeasureTicksFull*10u+35u);
