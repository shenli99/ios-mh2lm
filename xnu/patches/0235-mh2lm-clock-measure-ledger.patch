 #ifndef IOQCOM_GCC_H
@@ -40,6 +50,32 @@ enum : unsigned { kIOQcomGccSnapshotCount = 11 };
 /* C2-02: only the fixed-parent sample (gcc_pdm2_clk_src) is decoded. */
