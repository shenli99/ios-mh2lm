 void
+AppleCLCD::traceFrame(const char *phase)
+{
+	if (!fTrace) {
+		return;
+	}
+	uint64_t panel = sweet_fb_trace_hash(fPixels, fHeight, fRowBytes);
+	SweetFBTraceSwap local[SWEET_FB_TRACE_SLOTS];
+	uint32_t next;
+	IOLockLock(fLock);
+	memcpy(local, fTraceSwaps, sizeof(local));
+	next = fTraceSwapNext;
+	IOLockUnlock(fLock);
+	IOLog("SWEET FB TRACE: %s panel-hash=%llx swap-next=%u\n", phase, panel, next);
+	for (uint32_t n = 0; n < SWEET_FB_TRACE_SLOTS; n++) {
+		SweetFBTraceSwap *t = &local[n];
+		IOLog("SWEET FB TRACE: %s recent[%u] swap=%u mask=%#x ids=%u,%u,%u,%u r0=%d,%d,%d,%d\n",
+		    phase, n, t->swapID, t->mask, t->surface[0], t->surface[1],
+		    t->surface[2], t->surface[3], t->rect[0][0], t->rect[0][1],
+		    t->rect[0][2], t->rect[0][3]);
+	}
+	uint32_t id = 0;
+	for (uint32_t n = 0; n < SWEET_FB_TRACE_SLOTS; n++) {
+		if (local[n].mask & 1u) {
+			id = local[n].surface[0];
+		}
+	}
+	SweetSurface *s = id != 0 ? sweet_surface_copy(id) : NULL;
+	if (s != NULL) {
+		uint64_t source = sweet_fb_trace_hash(s->kernelAddress(), s->height, s->bytesPerRow);
+		IOLog("SWEET FB TRACE: %s source-surface=%u hash=%llx %ux%u fmt=%#x bpr=%u alloc=%u cache=%#x offset=%u\n",
+		    phase, id, source, s->width, s->height, s->pixelFormat, s->bytesPerRow,
+		    s->allocSize, s->cacheMode, s->offset);
+		s->release();
+	}
+}
