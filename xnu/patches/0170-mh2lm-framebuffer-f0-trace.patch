 #define SWEET_FB_LOGICAL_W              1125
 #define SWEET_FB_LOGICAL_H              2436
 #define SWEET_FB_FORMAT_BGRA            0x42475241
+#define SWEET_FB_TRACE_SLOTS            4
+#define SWEET_FB_TRACE_MAX_SELECTOR     32
+
+typedef struct {
+	uint32_t swapID;
+	uint32_t mask;
+	uint32_t surface[SWEET_FB_LAYERS];
+	int32_t rect[SWEET_FB_LAYERS][4];
+} SweetFBTraceSwap;
+
+static uint32_t sweet_fb_selector_trace[64];
+
+static uint64_t
+sweet_fb_trace_hash(uintptr_t base, uint32_t height, uint32_t stride)
+{
+	uint64_t hash = 1469598103934665603ULL;
+	if (base == 0 || height == 0 || stride == 0) {
+		return 0;
+	}
+	uint32_t first = height > 1400 ? 900 : 0;
+	uint32_t last = height > 1400 ? 1400 : height;
+	for (uint32_t y = first; y < last; y += 8) {
+		volatile const uint8_t *row = (volatile const uint8_t *)(base + (uint64_t)y * stride);
+		for (uint32_t x = 0; x < stride; x += 64) {
+			hash ^= row[x];
+			hash *= 1099511628211ULL;
+		}
+	}
+	return hash;
+}
 
