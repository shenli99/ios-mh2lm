 	  kIOQcomHaltCheck, kIOQcomCapQueryConfig|kIOQcomCapQueryRate, 0, 0, 1,
 	  {{kIOQcomSourceXODiv4,0,0}},
@@ -839,9 +846,11 @@ IOQcomGCC::measureClocks(void)
