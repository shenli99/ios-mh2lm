+   SWEET_LOG_WARN("SWEET MDSS: RPMh detach rc=%#x; votes preserved, no implicit powerdown\n",(unsigned)rc);
+  OSSafeReleaseNULL(fRPMh); fRPMhConsumer=0;
+ }
 }
 
