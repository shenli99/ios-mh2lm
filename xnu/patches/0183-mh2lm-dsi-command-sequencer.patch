  IOReturn setBrightness(uint32_t level);
diff --git a/iokit/Kernel/arm/SweetFBPerf.h b/iokit/Kernel/arm/SweetFBPerf.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetFBPerf.h
@@ -0,0 +1,31 @@
+/* Low-frequency CPU presentation evidence. Not a hardware flip/reuse fence.
+ * Fixed logarithmic microsecond bins; p50/p99 are bucket UPPER bounds.
+ */
+#ifndef SWEET_FB_PERF_H
+#define SWEET_FB_PERF_H
+#include <stdint.h>
+struct SweetFBTiming {
+ uint64_t count, totalNS, maxNS, overBudget;
+ uint64_t buckets[32];
+ void add(uint64_t ns,uint64_t budget) {
+  ++count; totalNS+=ns;
+  if (ns>maxNS) maxNS=ns;
+  if (ns>budget) ++overBudget;
+  uint64_t us=ns/1000u+(ns%1000u!=0); unsigned b=0;
+  while (b<31 && us>(1ULL<<b)) ++b;
+  ++buckets[b];
+ }
+ uint64_t percentile(unsigned percent) const {
+  if (!count) return 0;
+  uint64_t target=(count/100u)*percent+((count%100u)*percent+99u)/100u, sum=0;
+  for (unsigned b=0;b<32;++b) { sum+=buckets[b]; if (sum>=target) return b==31 ? maxNS/1000u+(maxNS%1000u!=0) : 1ULL<<b; }
+  return 1ULL<<31;
+ }
+};
+struct SweetFBPerf {
+ bool enabled;
+ uint64_t nextReportNS, firstPendingNS, latestPendingNS, lastPresentNS;
+ uint64_t swaps, coalesced, bytes, presents;
+ SweetFBTiming copy, present, query, pending, latest, interval;
+};
+#endif
diff --git a/iokit/Kernel/arm/SweetFBPerf.inc b/iokit/Kernel/arm/SweetFBPerf.inc
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetFBPerf.inc
@@ -0,0 +1,20 @@
+/* Caller owns the FB workloop gate; no allocation, sorting or per-frame log. */
+void
+AppleCLCD::reportPerf(uint64_t now)
+{
+ if (!fPerf.enabled) return;
+ if (!fPerf.nextReportNS) { fPerf.nextReportNS=now+15000000000ULL; return; }
+ if (now<fPerf.nextReportNS) return;
+ SWEET_LOG_INFO("SWEET FB PERF: v1 own-active=%u swaps=%llu coalesced=%llu cpu-presents=%llu copy-bytes=%llu; IRQ is not presentation\n",
+     fOwnScanoutActive,fPerf.swaps,fPerf.coalesced,fPerf.presents,fPerf.bytes);
+ const SweetFBTiming *values[]={&fPerf.copy,&fPerf.present,&fPerf.query,&fPerf.pending,&fPerf.latest,&fPerf.interval};
+ const char *names[]={"copy+barrier","cpu-present","provider-query","pending-first","pending-latest","cpu-interval"};
+ for (unsigned i=0;i<6;++i) {
+  const SweetFBTiming &t=*values[i];
+  SWEET_LOG_INFO("SWEET FB PERF: %s n=%llu total-us=%llu p50-upper-us=%llu p99-upper-us=%llu max-us=%llu over-budget=%llu\n",
+      names[i],t.count,t.totalNS/1000ULL,t.percentile(50),t.percentile(99),t.maxNS/1000ULL,t.overBudget);
+ }
+ fPerf.copy={}; fPerf.present={}; fPerf.query={}; fPerf.pending={}; fPerf.latest={}; fPerf.interval={};
+ fPerf.swaps=fPerf.coalesced=fPerf.bytes=fPerf.presents=0;
+ fPerf.nextReportNS=now+15000000000ULL;
+}
