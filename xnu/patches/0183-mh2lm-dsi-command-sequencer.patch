diff --git a/iokit/Kernel/arm/SweetDSICommand.h b/iokit/Kernel/arm/SweetDSICommand.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetDSICommand.h
@@ -0,0 +1,77 @@
+/* MH2LM DSI write protocol. Pure byte encoding; no MMIO or panel identity.
+ * Qualcomm embedded DMA headers follow LG dsi_ctrl_copy_and_pad_cmd().
+ * 64 bytes is the FIFO-store limit; 256 is the MEMORY embedded-DMA limit.
+ * In particular, a vendor command must never be split to fit the FIFO.
+ */
+#ifndef SWEET_DSI_COMMAND_H
+#define SWEET_DSI_COMMAND_H
+#include <stdint.h>
+#include <stddef.h>
+
+enum { SweetDSIFifoBytes=64, SweetDSIEmbeddedBytes=256,
+ SweetDSIMaxPayload=252, SweetDSIMaxSequence=16384, SweetDSIMaxCommands=64 };
+struct SweetDSIMessage {
+ uint8_t type, channel, waitMS;
+ const uint8_t *payload;
+ size_t length;
+};
+enum SweetDSIState { SweetDSIIdle, SweetDSIQuiescing, SweetDSITransferring,
+ SweetDSIDelay, SweetDSIComplete, SweetDSIFailed, SweetDSICancelled };
+struct SweetDSIStatus {
+ uint64_t token;
+ unsigned state, completed, total;
+ uint32_t irq, hardwareStatus, ack;
+ int result;
+ bool hardwareUncertain;
+};
+
+/* Only the write forms needed by this panel are supported. Read/BTA, ACK,
+ * other VCs and non-final batched packets need a separate completion model.
+ * Reject them, never silently alter the requested wire transaction. */
+static inline bool
+sweet_dsi_message_valid(const SweetDSIMessage &m)
+{
+ if (!m.payload || m.channel || !m.length || m.length>SweetDSIMaxPayload) return false;
+ return (m.type==0x05 && m.length==1) || (m.type==0x15 && m.length==2) ||
+     (m.type==0x39 && m.length>=2);
+}
+static inline bool
+sweet_dsi_next(const uint8_t *bytes,size_t length,size_t *offset,SweetDSIMessage *m)
+{
+ if (!bytes || !offset || !m || *offset>length || length-*offset<7) return false;
+ const uint8_t *p=bytes+*offset;
+ size_t n=((size_t)p[5]<<8)|p[6];
+ if (p[1]!=1 || p[3] || n>length-*offset-7) return false;
+ SweetDSIMessage next={p[0],p[2],p[4],p+7,n};
+ if (!sweet_dsi_message_valid(next)) return false;
+ *m=next; *offset+=7+n; return true;
+}
+static inline bool
+sweet_dsi_sequence_valid(const uint8_t *bytes,size_t length,unsigned *commands)
+{
+ if (!bytes || !length || length>SweetDSIMaxSequence) return false;
+ size_t offset=0; unsigned count=0;
+ while (offset<length) {
+  SweetDSIMessage m={};
+  if (++count>SweetDSIMaxCommands || !sweet_dsi_next(bytes,length,&offset,&m)) return false;
+ }
+ if (commands) *commands=count;
+ return true;
+}
+/* Output is 32-bit aligned by the caller. Padding is 0xff as in LG's memory
+ * command buffer. CRC/ECC are generated by hardware, not appended here. */
+static inline size_t
+sweet_dsi_encode(const SweetDSIMessage &m,uint8_t *out,size_t capacity)
+{
+ if (!sweet_dsi_message_valid(m) || !out) return 0;
+ bool longPacket=m.type==0x39;
+ size_t n=longPacket ? (m.length+7u)&~(size_t)3u : 4u;
+ if (n>capacity) return 0;
+ for (size_t i=0;i<n;++i) out[i]=0xff;
+ out[0]=longPacket ? (uint8_t)m.length : m.payload[0];
+ out[1]=longPacket ? (uint8_t)(m.length>>8) : (m.length==2 ? m.payload[1] : 0);
+ out[2]=m.type; out[3]=longPacket ? 0xc0 : 0x80;
+ if (longPacket) for (size_t i=0;i<m.length;++i) out[4+i]=m.payload[i];
+ return n;
+}
+#endif
