+void
+SweetBattery::logChargePolicy(void)
+{
+	/* Linux's PM8150B SMB5 probe sets these before releasing CHG_DISABLE.
+	 * The port only reads them here, so a log can distinguish an explicit
+	 * charger disable from an input suspend, absent Type-C sink, zero ICL, or
+	 * disabled AICL. It deliberately cannot identify Linux's high-level voter. */
+	uint8_t path = 0, apsd = 0, cmdIl = 0, icl = 0, aicl = 0;
+	uint8_t sink = 0, typec = 0, misc = 0, smbEn = 0, smbCfg = 0;
+	bool ok = !sweet_spmi_read(SWEET_BATT_SID, SWEET_BATT_DCDC_PATH, &path) &&
+	    !sweet_spmi_read(SWEET_BATT_SID, SWEET_BATT_USBIN_APSD, &apsd) &&
+	    !sweet_spmi_read(SWEET_BATT_SID, SWEET_BATT_USBIN_CMD_IL, &cmdIl) &&
+	    !sweet_spmi_read(SWEET_BATT_SID, SWEET_BATT_USBIN_ICL, &icl) &&
+	    !sweet_spmi_read(SWEET_BATT_SID, SWEET_BATT_USBIN_AICL, &aicl) &&
+	    !sweet_spmi_read(SWEET_BATT_SID, SWEET_BATT_TYPEC_SNK, &sink) &&
+	    !sweet_spmi_read(SWEET_BATT_SID, SWEET_BATT_TYPEC_STATE, &typec) &&
+	    !sweet_spmi_read(SWEET_BATT_SID, SWEET_BATT_TYPEC_MISC, &misc) &&
+	    !sweet_spmi_read(SWEET_BATT_SID, SWEET_BATT_SMB_EN, &smbEn) &&
+	    !sweet_spmi_read(SWEET_BATT_SID, SWEET_BATT_SMB_CFG, &smbCfg);
+	IOLog("SWEET BATT POLICY: path=%#x use-usb=%u valid-input=%u path-suspend=%u "
+	    "cmd-il=%#x cmd-suspend=%u icl=%umA apsd=%#x done=%u enum=%u "
+	    "aicl=%#x aicl-en=%u aicl-adc=%u aicl-rerun=%u collapse-suspend=%u "
+	    "sink=%#x typec=%#x state-attached=%u misc=%#x cc-attached=%u vbus=%u "
+	    "smben=%#x override=%u override-val=%u smbcfg=%#x smb-sel=%u read-ok=%d\n",
+	    (unsigned)path, (path & 0x10u) ? 1 : 0, (path & 0x01u) ? 1 : 0,
+	    (path & 0x40u) ? 1 : 0, (unsigned)cmdIl, (cmdIl & 0x01u) ? 1 : 0,
+	    (unsigned)icl * 50u, (unsigned)apsd, (apsd & 0x80u) ? 1 : 0,
+	    (apsd & 0x10u) ? 1 : 0, (unsigned)aicl, (aicl & 0x04u) ? 1 : 0,
+	    (aicl & 0x08u) ? 1 : 0, (aicl & 0x10u) ? 1 : 0,
+	    (aicl & 0x80u) ? 1 : 0, (unsigned)sink, (unsigned)typec,
+	    (typec & 0x20u) ? 1 : 0, (unsigned)misc, (misc & 0x01u) ? 1 : 0,
+	    (misc & 0x20u) ? 1 : 0,
+	    (unsigned)smbEn, (smbEn & 0x08u) ? 1 : 0, (smbEn & 0x10u) ? 1 : 0,
+	    (unsigned)smbCfg, (smbCfg & 0x10u) ? 1 : 0, ok ? 1 : 0);
+}
+
 unsigned
 SweetBattery::estimatePercent(unsigned mv)
 {
@@ -633,6 +679,7 @@
 		    (unsigned)pause, (unsigned)cfg2, (unsigned)smbEn,
 		    (unsigned)rawCurrent, signedCurrent, currentUa, configOk ? 1 : 0,
 		    currentOk ? 1 : 0);
+		logChargePolicy();
 	}
