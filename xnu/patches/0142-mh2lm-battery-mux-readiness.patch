+/* Battery starts in IOKit before BSD starts the key mux. Keep the one-shot
+ * subscription independent of the mux workloop. This lock protects callback
+ * lifetime only; no MMIO, workloop waits or consumer work runs under it. */
+static IOLock *
+readinessLock(void)
+{
+	IOLock *lock = __atomic_load_n(&readyLock, __ATOMIC_ACQUIRE);
+	if (!lock) {
+		IOLock *candidate = IOLockAlloc();
+		if (!candidate) {
+			return NULL;
+		}
+		if (__atomic_compare_exchange_n(&readyLock, &lock, candidate, false,
+		    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+			lock = candidate;
+		} else {
+			IOLockFree(candidate);
+		}
+	}
+	return lock;
+}
+
+static void
+publishReadiness(int result)
+{
+	IOLock *lock = readinessLock();
+	if (!lock) {
+		__atomic_store_n(&published, -1, __ATOMIC_RELEASE);
+		return;
+	}
+	IOLockLock(lock);
+	__atomic_store_n(&published, result, __ATOMIC_RELEASE);
+	if (readyNotify) {
+		readyNotify(readyContext, result == 1 ? SWEET_MUX_READY : SWEET_MUX_FAILED);
+		readyNotify = NULL;
+		readyContext = NULL;
+	}
+	IOLockUnlock(lock);
+}
+
+extern "C" int
+sweet_spmi_mux_watch_ready(SweetMuxNotify notify, void *context)
+{
+	IOLock *lock = readinessLock();
+	if (!lock || !notify || !context) {
+		return -1;
+	}
+	IOLockLock(lock);
+	if (readyNotify) {
+		IOLockUnlock(lock);
+		return -1; /* one battery instance, never replace a live context */
+	}
+	int result = __atomic_load_n(&published, __ATOMIC_ACQUIRE);
+	if (result == 0) {
+		readyNotify = notify;
+		readyContext = context;
+	} else {
+		notify(context, result == 1 ? SWEET_MUX_READY : SWEET_MUX_FAILED);
+	}
+	IOLockUnlock(lock);
+	return 0;
+}
+
+extern "C" void
+sweet_spmi_mux_unwatch_ready(void *context)
+{
+	IOLock *lock = __atomic_load_n(&readyLock, __ATOMIC_ACQUIRE);
+	if (!lock) {
+		return;
+	}
+	IOLockLock(lock);
+	if (readyContext == context) {
+		readyNotify = NULL;
+		readyContext = NULL;
+	}
+	IOLockUnlock(lock);
+}
+
+static int
+startFailed(void)
+{
+	publishReadiness(-1);
+	return -1;
+}
 
