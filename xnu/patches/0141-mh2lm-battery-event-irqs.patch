+static IOReturn
+bindingAction(OSObject *, void *arg0, void *arg1, void *, void *)
+{
+	BindingRequest *request = (BindingRequest *)arg0;
+	bool detach = arg1 != NULL;
+	unsigned group = request->group;
+	MuxBinding &binding = bindings[group];
+	if (detach) {
+		if (binding.context != request->context || !binding.notify) {
+			return kIOReturnSuccess;
+		}
+		bool running = beginRouteUpdate();
+		if (!removeGroup(group) && running) {
+			SWEET_LOG_ERROR("SWEET MUX: detach cleanup failed; all PMIC consumers stopped\n");
+			disableHardware();
+		}
+		binding.notify = NULL;
+		binding.context = NULL;
+		binding.events = 0;
+		if (running) {
+			endRouteUpdate();
+		}
+		return kIOReturnSuccess;
+	}
+	unsigned current = __atomic_load_n(&state, __ATOMIC_ACQUIRE);
+	if (binding.notify || (current != 1u && current != 2u)) {
+		return kIOReturnNotReady;
+	}
+	/* Resolve only unique EE0 IRQ-owned channels before reading channel MMIO. */
+	unsigned found = 0;
+	for (unsigned i = 0; i < sizeof(routes) / sizeof(routes[0]); ++i) {
+		MuxRoute &route = routes[i];
+		if (route.group != group || !(request->events & route.token)) {
+			continue;
+		}
+		found |= route.token;
+		route.apid = findOwnedApid(route.sid, route.per, apidCount);
+		if (route.apid == MUX_NO_APID) {
+			SWEET_LOG_ERROR("SWEET MUX: %s has no unique EE0 IRQ-owned APID\n", route.name);
+			return kIOReturnNotPermitted;
+		}
+		route.channel = ml_io_map(SWEET_DEV_SPMI_CHNLS_PA + 0x10000u * route.apid, 0x1000);
+		if (!route.channel || route.writePoisoned) {
+			return kIOReturnNotReady;
+		}
+		route.oldAccess = read32(route.channel, 0x100u);
+		SWEET_LOG_INFO("SWEET MUX: attach route=%s apid=%u acc=%#x status=%#x\n",
+		    route.name, route.apid, route.oldAccess, read32(route.channel, 0x104u));
+	}
+	if (found != request->events || !beginRouteUpdate()) {
+		return kIOReturnNotReady;
+	}
+	binding.notify = request->notify;
+	binding.context = request->context;
+	binding.events = request->events;
+	for (unsigned i = 0; i < sizeof(routes) / sizeof(routes[0]); ++i) {
+		MuxRoute &route = routes[i];
+		if (route.group != group || !(found & route.token)) {
+			continue;
+		}
+		route.active = true;
+		if (!configureRoute(route)) {
+			SWEET_LOG_ERROR("SWEET MUX: attach setup failed route=%s; battery IRQ unavailable\n", route.name);
+			if (!removeGroup(group)) {
+				SWEET_LOG_ERROR("SWEET MUX: attach rollback failed; all PMIC consumers stopped\n");
+				disableHardware();
+			}
+			binding.notify = NULL;
+			binding.context = NULL;
+			binding.events = 0;
+			endRouteUpdate();
+			return kIOReturnIOError;
+		}
+	}
+	SWEET_LOG_INFO("SWEET MUX: consumer attached group=%u events=%#x intid=%u\n",
+	    group, found, MUX_INTID);
+	endRouteUpdate();
+	return kIOReturnSuccess;
+}
+
+extern "C" int
+sweet_spmi_mux_attach(unsigned group, unsigned events, SweetMuxNotify notify,
+    void *context)
+{
+	if (group != MUX_BATTERY || !events || (events & ~0x0fu) || !notify || !context) {
+		return -1;
+	}
+	int ready = __atomic_load_n(&published, __ATOMIC_ACQUIRE);
+	if (ready != 1) {
+		return ready == 0 ? -2 : -1;
+	}
+	BindingRequest request = {group, events, notify, context};
+	return workLoop->runAction(bindingAction, workLoop, &request) == kIOReturnSuccess ? 0 : -1;
+}
+
+extern "C" void
+sweet_spmi_mux_detach(unsigned group, void *context)
+{
+	if (group != MUX_BATTERY || __atomic_load_n(&published, __ATOMIC_ACQUIRE) != 1) {
+		return;
+	}
+	BindingRequest request = {group, 0, NULL, context};
+	(void)workLoop->runAction(bindingAction, workLoop, &request, context);
+}
