+ regs[TCS + 4] |= 1u << s->fTCSIndex;
+ for (unsigned i = 0; i < 3; ++i) { fakeTicks += 100000; s->fTimer->action(s, s->fTimer); }
+ show("rail-kept-irq"); destroy(s, n); reboot();
