diff --git a/drivers/DarwinBoot/DarwinBootPkg/Driver/BootArgs.h b/drivers/DarwinBoot/DarwinBootPkg/Driver/BootArgs.h
--- a/drivers/DarwinBoot/DarwinBootPkg/Driver/BootArgs.h
+++ b/drivers/DarwinBoot/DarwinBootPkg/Driver/BootArgs.h
@@ -4,7 +4,8 @@
 
 #include <Base.h>
 
-// Darwin 23 pexpert/pexpert/arm64/boot.h ABI; all fields are little-endian.
+// XNU 8796 pexpert/pexpert/arm64/boot.h ABI; all fields are little-endian.
+#define DARWIN_BOOT_LINE_LENGTH 608
 typedef struct {
   UINT16  Revision;
   UINT16  Version;
@@ -18,7 +19,7 @@
   UINT32  TreePadding;
   UINT64  DeviceTree;
   UINT32  DeviceTreeLength;
-  CHAR8   CommandLine[1024];
+  CHAR8   CommandLine[DARWIN_BOOT_LINE_LENGTH];
   UINT32  FlagsPadding;
   UINT64  BootFlags;
   UINT64  MemorySizeActual;
@@ -27,7 +28,8 @@
 STATIC_ASSERT (OFFSET_OF (DARWIN_BOOT_ARGS, DeviceTree) == 0x60, "DT ABI");
 STATIC_ASSERT (OFFSET_OF (DARWIN_BOOT_ARGS, Video) == 0x28, "video ABI");
 STATIC_ASSERT (OFFSET_OF (DARWIN_BOOT_ARGS, CommandLine) == 0x6c, "command line ABI");
-STATIC_ASSERT (OFFSET_OF (DARWIN_BOOT_ARGS, MemorySizeActual) == 0x478, "memory ABI");
-STATIC_ASSERT (sizeof (DARWIN_BOOT_ARGS) == 0x480, "boot_args ABI");
+STATIC_ASSERT (OFFSET_OF (DARWIN_BOOT_ARGS, BootFlags) == 0x2d0, "flags ABI");
+STATIC_ASSERT (OFFSET_OF (DARWIN_BOOT_ARGS, MemorySizeActual) == 0x2d8, "memory ABI");
+STATIC_ASSERT (sizeof (DARWIN_BOOT_ARGS) == 0x2e0, "boot_args ABI");
 
 #endif
diff --git a/drivers/DarwinBoot/DarwinBootPkg/Driver/DarwinBoot.c b/drivers/DarwinBoot/DarwinBootPkg/Driver/DarwinBoot.c
--- a/drivers/DarwinBoot/DarwinBootPkg/Driver/DarwinBoot.c
+++ b/drivers/DarwinBoot/DarwinBootPkg/Driver/DarwinBoot.c
@@ -562,7 +562,7 @@
   UINTN                           Stride;
   UINT32                          Version;
   UINTN                           Attempt;
-  CHAR8                           CommandLine[1024];
+  CHAR8                           CommandLine[DARWIN_BOOT_LINE_LENGTH];
   UINT64                          Video[6];
 
   (VOID)This;
